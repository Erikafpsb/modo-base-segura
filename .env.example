# Supabase Configuration
# Preencha com as variáveis do seu projeto Supabase no dashboard da Vercel (Settings -> Environment Variables)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica-ou-anon"
VITE_SUPABASE_PROJECT_ID="seu-id-de-projeto"

# Variáveis para SSR / Funções Server-side
